{#
 # One track: its play button (what it plays from: music_source() - the
 # site's excerpt, a catalogue's preview, or the release's embed), its
 # place, its title, its waveform, its length. `single` renders the button
 # and the title alone (music_player(track)). A track not out yet, or withheld
 # in the visitor's country, is greyed with the reason (Service\Availability).
 #}
{% set source = music_source(track) %}
{% set unavailable = music_unavailable(track) %}
{# Why it does not play, when it does not: its day to come (a track kept for its album), or the visitor's country. #}
{% set why = not unavailable ? null : (unavailable.reason == 'region'
    ? '@music.track.blocked'|trans
    : (unavailable.date ? '@music.release.out_on'|trans({date: unavailable.date|format_date('long')}) : '@music.release.upcoming'|trans)) %}
{% set label = track.displayTitle %}
{% set button %}
<button type="button" class="music-track-play"
    {%- if source %} data-music-track data-src="{{ source.src }}" data-kind="{{ source.kind }}"{% else %} disabled{% endif %}
    data-title="{{ label }}" data-release="{{ release ? release.slug }}" data-release-title="{{ release ? release.title }}"
    {%- if release and release.artwork %} data-cover="{{ release.artwork }}"{% endif %}
    {#- "Listen in full" from the bar, on any page: where it asks for the release's platforms. #}
    {%- if music_has_full(release) %} data-full="{{ path('music_release_full', {slug: release.slug}) }}"{% endif %}
    {#- A play of it is counted there, once it was heard (player.js). #}
    {%- if source and source.kind != 'embed' and track.id %} data-count="{{ path('music_track_play', {id: track.id}) }}"{% endif %}
    {%- if source and source.whole %} data-whole{% endif %}
    {%- if release %} data-about="{{ path('music_release_full', {slug: release.slug}) }}"{% endif %}
    {%- if track.peaks %} data-peaks="{{ track.peaks|json_encode }}"{% endif %}
    aria-pressed="false" aria-label="{{ (source and source.kind == 'embed' ? '@music.player.open_embed' : '@music.player.play_track')|trans({title: label}) }}">
    <i class="fa-solid {{ source and source.kind == 'embed' ? 'fa-up-right-from-square' : 'fa-play' }} music-icon-play" aria-hidden="true"></i><i class="fa-solid fa-pause music-icon-pause" aria-hidden="true"></i>
</button>
{% endset %}
{% if single|default(false) %}
<span class="music-track is-single{{ why ? ' is-unavailable' }}" data-music-row{% if why %} title="{{ why }}"{% endif %}>{{ button }}<span class="music-track-title">{{ label }}</span></span>
{% else %}
<li class="music-track{{ waves ? ' has-wave' }}{{ why ? ' is-unavailable' }}" data-music-row>
    {{ button }}
    <span class="music-track-no">{{ track.position }}</span>
    <span class="music-track-title">{{ label }}
        {%- if track.title and track.work %}<small>{{ track.work.composer }}{{ track.movement ? ' · ' ~ track.movement }}</small>{% endif %}
        {%- if track.performers %}<small>{{ track.performers }}</small>{% endif %}
        {%- if source and source.kind == 'preview' %}<small>{{ '@music.player.preview'|trans }}</small>{% endif %}
        {%- if why %}<small class="music-track-why">{{ why }}</small>{% endif %}
    </span>
    {% if waves %}<canvas{% if track.id %} id="music-wave-{{ track.id }}"{% endif %} class="music-wave" data-peaks="{{ (track.peaks ?? [])|json_encode }}" aria-hidden="true"></canvas>{% endif %}
    <span class="music-track-time">{{ track.duration|music_duration }}</span>
</li>
{% endif %}
