parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$owner of method Base\\Entity\\Thread\:\:addOwner\(\) expects App\\Entity\\User\|null, Base\\Entity\\User&Symfony\\Component\\Security\\Core\\User\\UserInterface given\.$#'
			identifier: argument.type
			count: 1
			path: src/Controller/Admin/Crud/ReleaseCrudController.php

		-
			message: '#^Parameter \#1 \$owner of method Base\\Entity\\Thread\:\:addOwner\(\) expects App\\Entity\\User\|null, Base\\Entity\\User&Symfony\\Component\\Security\\Core\\User\\UserInterface given\.$#'
			identifier: argument.type
			count: 1
			path: src/Controller/Admin/Crud/VideoCrudController.php

		-
			message: '#^Parameter \#1 \$owner of method Base\\Entity\\Thread\:\:__construct\(\) expects App\\Entity\\User\|null, Base\\Entity\\User\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Entity/Release.php

		-
			message: '#^Parameter \#1 \$array \(non\-empty\-list\<float\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: src/Entity/Track.php

		-
			message: '#^Parameter \#1 \$array \(non\-empty\-list\<non\-falsy\-string\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: src/Entity/Track.php

		-
			message: '#^Parameter \#1 \$owner of method Base\\Entity\\Thread\:\:__construct\(\) expects App\\Entity\\User\|null, Base\\Entity\\User\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Entity/Video.php

		-
			message: '#^Using nullsafe property access "\?\-\>value" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Repository/WorkRepository.php

		-
			message: '#^Call to sprintf contains 2 placeholders, 1 value given\.$#'
			identifier: argument.sprintf
			count: 1
			path: src/Service/HeroFrame.php

		-
			message: '#^Parameter \#1 \$array \(list\<string\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: src/Service/JsonLd.php

		-
			message: '#^Strict comparison using \!\=\= between array\{\} and non\-empty\-array\<''@type''\|''itemListElement''\|''name''\|''numberOfItems''\|''url''\|int\<0, max\>, array\<''@type''\|''name''\|''url''\|int\<0, max\>, array\{''@type''\: ''ListItem'', position\: int\<1, max\>, item\: array\{''@type''\: ''MusicRecording'', name\?\: non\-falsy\-string, duration\?\: non\-falsy\-string, isrcCode\?\: non\-falsy\-string, recordingOf\?\: array\{''@type''\: ''MusicComposition'', name\?\: non\-falsy\-string, composer\: array\{''@type''\: ''Person'', name\: string\|null\}\}\}\}\|non\-falsy\-string\>\|int\<1, max\>\|string\>\|int\<1, max\>\|non\-empty\-string will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Service/JsonLd.php

		-
			message: '#^Using nullsafe property access "\?\-\>url" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: src/Service/Player.php

		-
			message: '#^Parameter \#1 \$rg of static method Base\\Music\\Service\\PosterPicker\:\:spread\(\) expects list\<float\>, non\-empty\-list\<int\<\-255, 255\>\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Service/PosterPicker.php
